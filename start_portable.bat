@echo off
REM start_portable.bat - sets up a portable Python venv, installs requirements, and launches Seed-VC real-time app

SETLOCAL ENABLEEXTENSIONS ENABLEDELAYEDEXPANSION
echo ===============================
echo Seed-VC Portable Start Script
echo ===============================
:: Check Python availabilitypython --version >nul 2>&1if %ERRORLEVEL% NEQ 0 (    echo Python is not found on PATH. Please install Python 3.8+ and rerun this script.    pause    exit /b 1):: Create virtual environment if missingif not exist venv (    echo Creating virtual environment in .\venv ...    python -m venv venv    if %ERRORLEVEL% NEQ 0 (        echo Failed to create virtual environment. Ensure Python 3.8+ is installed.        pause        exit /b 1    )) else (    echo Using existing virtual environment .\venv):: Activate venv and upgrade pipcall venv\Scripts\activate.batpython -m pip install --upgrade pip:: Install requirements if file existsif exist requirements.txt (    echo Installing Python requirements from requirements.txt ...    pip install -r requirements.txt) else (    echo requirements.txt not found. Skipping dependency install. You can create requirements.txt or install manually.):: Optional: pre-download model checkpoints if helper script existsif exist scripts\download_models.py (    echo Downloading model checkpoints ...    python scripts\download_models.py || echo Warning: automatic model download failed. You can download checkpoints manually.) else (    echo No automatic model-download script found. If you need model checkpoints, please follow README instructions.):: Parse optional parameter: --echo to enable post-processing echo controlset "ECHO_CONTROL=false"if "%1"=="--echo" set "ECHO_CONTROL=true":: Run the realtime/streaming app (tries app_vc.py, then app_vc_v2.py, then app.py)if exist app_vc.py (    echo Launching app_vc.py ...    rem Pass ECHO_CONTROL as environment variable for downstream tools    set ECHO_CONTROL=%ECHO_CONTROL%    python app_vc.py --fp16 False %*) else if exist app_vc_v2.py (    echo Launching app_vc_v2.py ...    set ECHO_CONTROL=%ECHO_CONTROL%    python app_vc_v2.py --compile False %*) else if exist app.py (    echo Launching app.py ...    set ECHO_CONTROL=%ECHO_CONTROL%    python app.py %*) else (    echo No known entrypoint found (app_vc.py / app_vc_v2.py / app.py). Please run the appropriate script manually.):: If ECHO_CONTROL was requested, try to post-process the last output file using the echo control utility (best-effort)if "%ECHO_CONTROL%"=="true" (    echo Attempting to run echo-control post-processor on outputs (if available)...    if exist "modules\echo_control.py" (        echo Running modules\echo_control.py --help to see usage.        python modules\echo_control.py --help    ) else (        echo echo_control utility not found in modules\echo_control.py    ))echo Done. Close this window to exit.pause